DATABASE_URL=postgres://library:library@localhost:5434/library
DB_MAX_CONNECTIONS=10

# At least 32 chars. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_TTL_MINUTES=60
# Set to true in production (HTTPS) so the session cookie is Secure.
COOKIE_SECURE=false

# Origins allowed to call /api/v1 from a browser (e.g. Flutter web dev). "*" = any.
CORS_ORIGINS=http://localhost:8080

# Creates the first admin on startup if the users table is empty.
ADMIN_EMAIL=admin@library.local
ADMIN_PASSWORD=change-me-please

# Library timezone: used for due dates and fines.
TZ=Asia/Phnom_Penh

RUST_LOG=info,server=debug,tower_http=info

# Bag deposit desk
BAG_PHOTO_DIR=data/bag-photos
MODELS_DIR=models
